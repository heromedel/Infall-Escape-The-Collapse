; Infall: Deck Collapse, a card battle prototype.
config_version=5

[application]

config/name="Infall: Deck Collapse"
config/description="Card battles between ships, built from their systems and crew."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Catalog="*res://scripts/core/catalog.gd"
Settings="*res://scripts/core/settings.gd"
Sounds="*res://scripts/audio/sound_bank.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=2
