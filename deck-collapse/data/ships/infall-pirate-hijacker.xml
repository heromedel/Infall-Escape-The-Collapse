<?xml version="1.0" encoding="UTF-8"?>
<!-- Terran Pirate Hijacker (ship-suggestions.md, 2026-10-22). Band 5 (bands 4-6), doomed Terran clusters and borders.
     It wants your ship intact: spores your engines and piloting, then boards. Gap references are listed in README.md. -->
<ship bands="4-6" name="Terran Pirate Hijacker" race="Terran" faction="Pirates" color="#FF8500" hull="14" missiles="6">
  <note>A rusty Terran cruiser with a stolen Azurethea spore launcher bolted on. Cut the launcher's conduit spur and the stolen weapon goes dark.</note>
  <power kind="AZC" level="3"/>                                     <!-- G2: 7 drawing systems, one is off at a time -->
  <system type="piloting" level="2" draws="false"/>
  <system type="sensors" level="1" draws="false"/>
  <system type="airlock" level="2" draws="false"/>
  <system type="shields" level="2"/>
  <system type="engines" level="3"/>
  <system type="lifeSupport" level="1"/>
  <system type="medBay" level="2"/>
  <system type="teleport" level="2"/>
  <system type="weapon" id="weaponsA" name="Weapons A" level="2">    <!-- G3 -->
    <weapon name="Gat 2.1 Twinshot" kind="laser" power="1" shots="2" damage="1" conduitDamage="10" mount="3"/>
  </system>
  <system type="weapon" id="weaponsB" name="Weapons B" level="1" maxSlots="1">
    <weapon name="Sporewing" kind="missile" power="1" shots="1" damage="0" spores="true" stun="true" tech="biomechanical" mount="4"/>  <!-- G5, G10 -->
  </system>
  <crew name="Captain" race="Terran" station="piloting"/>
  <crew name="Gunner" race="Terran" station="weaponsB"/>
  <crew name="Boarder" race="Terran" station="teleport" combat="1"/>
  <crew name="Boarder" race="Terran" station="teleport" combat="1"/>
  <crew name="Engineer" race="Terran" station="engines"/>
  <!-- G19: suggested floor layout and conduits = ship-suggestions.md (content/ships/pirate-hijacker/ship.xml on Cloud-C-Init-Coding). -->
  <!-- The captain's plan (Ai-Generated-Proposal example, from this ship's note: it wants your ship intact).
       weight: the chance (0–0.9) the captain follows a line when it picks a target; leave it out for 0.75. Weights
       above 0.9 are lowered to 0.9. Easy captains halve them, Hard add 0.1. A failed roll only means the captain
       chooses as usual. when: always (default), enemyWeaponsDown, enemyShieldsDown, enemyWounded.
       weapon: only this weapon (by name) follows the line. -->
  <ai plan="crew-kill">
    <target system="engines" weapon="Sporewing" weight="0.8"/>
    <target system="piloting" weapon="Sporewing"/>
    <target system="weapon" weapon="Gat 2.1 Twinshot" weight="0.8"/>
    <target system="lifeSupport" when="enemyWeaponsDown" weapon="Gat 2.1 Twinshot" weight="0.8"/>
    <target system="medBay" when="enemyWounded" weight="0.5"/>
  </ai>
</ship>
