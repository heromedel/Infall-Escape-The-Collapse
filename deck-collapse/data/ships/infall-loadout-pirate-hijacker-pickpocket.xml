<?xml version="1.0" encoding="UTF-8"?>
<!-- "Pickpocket": the Hijacker's band 1 loadout (ship-suggestions.md, 2026-10-29), a patch of the Hijacker (G18).
     The Cutpurse without the stolen spore launcher: no non-vanilla weapons in band 1. No Doors or Medbay, so fire is its weakness. -->
<loadout bands="1-1" ship="Terran Pirate Hijacker" name="Pickpocket" inherit="Patch" hull="9" missiles="0">
  <power kind="AZC" level="2"/>
  <system type="piloting" level="1"/>
  <system type="sensors" removed="true"/>
  <system type="airlock" removed="true"/>
  <system type="shields" level="1"/>
  <system type="engines" level="1"/>
  <system type="medBay" removed="true"/>
  <system type="teleport" level="1"/>
  <system id="weaponsA" level="1"/>
  <system id="weaponsB" removed="true"/>
  <crew>
    <member name="Captain" race="Terran" station="piloting"/>
    <member name="Gunner" race="Terran" station="weaponsA"/>
    <member name="Boarder" race="Terran" station="teleport" combat="1"/>
  </crew>
  <!-- Captain plan, Ai-Generated-Proposal (2026-10-30). Lines marked G22-G27 use the plan lines for those gaps (README.md); Deck Collapse has them now. -->
  <ai plan="crew-kill">
    <!-- No Sporewing: shoot the guns, board the guns, then the Med Bay. Replaces the Hijacker's plan. -->
    <target unless="ownCrewIn" system="weapon" weapon="Gat 2.1 Twinshot" weight="0.8"/>
    <target system="medBay" when="enemyWounded" unless="ownCrewIn" weapon="Gat 2.1 Twinshot" weight="0.5"/>   <!-- G27 -->
    <board system="weapon" weight="0.8"/>                                                                       <!-- G23 -->
    <board system="medBay" when="enemyWounded" weight="0.6"/>
  </ai>
</loadout>
