<?xml version="1.0" encoding="UTF-8"?>
<!-- "Pappus": the Burr's band 1 loadout (ship-suggestions.md, 2026-10-29), a patch of the scout (G18).
     No Supershield, no Medbay, plain lasers: no non-vanilla weapons or new tech in band 1. -->
<loadout bands="1-2" ship="Burr" name="Pappus" inherit="Patch">
  <power kind="pool" level="7"/>
  <system type="supershield" removed="true"/>
  <system type="medBay" removed="true"/>
  <system type="weapon" id="weaponsA" name="Weapons A" level="1">
    <weapon name="Coil" kind="laser" power="1" shots="1" damage="1" tech="biomechanical"/>
  </system>
  <system type="weapon" id="weaponsB" name="Weapons B" level="1">
    <weapon name="Coil" kind="laser" power="1" shots="1" damage="1" tech="biomechanical"/>
  </system>
  <!-- Captain plan, Ai-Generated-Proposal (2026-10-30). Lines marked G22-G27 use the plan lines for those gaps (README.md); Deck Collapse has them now. -->
  <ai plan="destroy">
    <!-- As the Burr, with plain lasers. -->
    <target system="weapon" weapon="Coil" weight="0.8"/>
    <target system="engines" weapon="Coil" when="enemyWeaponsDown"/>
  </ai>
</loadout>
