<?xml version="1.0" encoding="UTF-8"?>
<!--
  EVB battlesuit types for Infall: Deck Collapse. An EVB Dock holds one suit type; each level adds one
  Launch card. A launch needs a free crew member in the dock, costs the suit's power and its level must be at
  least that cost. A suit stays out for "turns" of its captain's turns.

  action  shoot      fires at the target system as each of its captain's turns ends (shots, damage, shields, ion)
          intercept  shoots down the first enemy torpedo each enemy turn
          repair     repairs 1 damage on its ship's most damaged system as each of its captain's turns ends
          board      clings to the target system: it and the hull take 1 damage as each enemy turn ends
  price   Mawjig, priced as the matching drone (docs/reference/drone-prices.md, x 0.242)
-->
<suits>
  <suit id="assault" name="Assault Suit" cost="2" turns="3" action="shoot" shots="2" damage="1" shields="pop" price="12.11">
    Fires 2 bolts at its target as each of your turns ends.
  </suit>
  <suit id="ion" name="Ion Suit" cost="2" turns="3" action="shoot" shots="1" damage="0" shields="pop" ion="true" price="12.11">
    Fires an ion charge at its target as each of your turns ends.
  </suit>
  <suit id="cutter" name="Cutter Suit" cost="2" turns="3" action="shoot" shots="1" damage="2" shields="reduce" neverMisses="true" price="12.11">
    Sweeps a 2 damage beam over its target as each of your turns ends. Shield layers cut its damage.
  </suit>
  <suit id="guardian" name="Guardian Suit" cost="2" turns="3" action="intercept" price="12.11">
    Shoots down the first enemy torpedo each enemy turn.
  </suit>
  <suit id="repair" name="Repair Suit" cost="1" turns="3" action="repair" price="7.26">
    Repairs 1 damage on your most damaged system as each of your turns ends.
  </suit>
  <suit id="boarder" name="Boarding Suit" cost="3" turns="3" action="board" price="16.94">
    Bores into the target system. It and the hull take 1 damage as each enemy turn ends.
  </suit>
</suits>
