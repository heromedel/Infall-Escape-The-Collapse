<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rule numbers for Infall: Deck Collapse that aren't tied to one system, weapon or suit.
  Lists by skill read untrained, Veteran, Master. Edit to rebalance; the game reads this file at start.
-->
<rules>
  <!-- The Jig Drive gains a charge per working Engines level at the end of each turn that Engines and Piloting
       work and at least 1 power was burned in the Engines (heromedel, 2026-10-29). At this many it can jump. -->
  <jump chargesNeeded="24"/>

  <!-- Crew in a damaged, breached or burning system may draw an extra Repair card each turn.
       Uses the crew member's Repair skill. -->
  <crewDraw repair="10,15,20"/>

  <!-- Each point of damage to a system has this % chance to wound each crew member standing in it.
       Weapons marked woundsCrew (torpedoes, beams) always wound. -->
  <crewHit chancePerDamage="25"/>

  <!-- As each turn ends, a fire may spread to a neighbouring system (the next tile left or right).
       Each Airlock Control level lowers the chance. A fire burns out when its system is broken, and may burn out
       when the air has run out. -->
  <fire spreadChance="30" spreadPerAirlockLevel="-10" spreadMinimum="5" burnOutWithoutAir="50"/>

  <!-- Turns an enemy boarder needs to move out of the system they're in to another, by your Airlock Control level
       (0 = none; level 1 doesn't slow them, heromedel). Teleporting and venting aren't slowed. -->
  <airlock boarderExitTurns="0,0,1,2,3"/>

  <!-- Mawjig (docs/reference/mawjig-cost-table.md, band 1). A wreck pays rewardPercent of the ship's value;
       killing the crew pays crewKillBonus % more. -->
  <economy rewardPercent="2.5" crewKillBonus="30" hullRepair="0.48" missile="1.45" suitPart="1.94" crew="10.89"
      skillVeteran="0.25" skillMaster="0.37" jumpCost="1.21" startingMawjig="12.11" enemyPursePercent="2.5"/>
  <!-- startingMawjig: a run's purse (GDD 8K, Proposed).
       enemyPursePercent: an enemy ship carries its own wreck reward to pay for its shots, this % of its ship value
       (economy-findings F11, Proposed, heromedel 2026-10-28; no band adjustment yet, as band 1 is x1.0). Unspent
       Mawjig is not added to the salvage (F11, Likely).
       suitPart: one battlesuit launch's parts in Classic ammo, the genre's drone part (8 scrap x 0.242). -->

  <!-- Stations between battles (stores, heromedel 2026-10-29). The next station comes gapMin to gapMax stops after
       the last (Station Frequency: 1 in 5–10); each sells hull repair, missiles and suit parts, plus `sections`
       random sections (systems, weapons, battlesuits, crew) of itemsPerSection items. Items sell back at
       sellPercent of their price (genre). cargoSlots hold weapons and suits that aren't in the deck (genre: 4).
       A bought weapon gets its own weapon system up to maxWeaponSystems. crewSkillChance: % that a crew member for
       hire is a Veteran in one skill (Ai-Generated-Proposal). systemRepair: Mawjig per damage point, fire or breach
       with Store System Repair On (Ai-Generated-Proposal: the hull repair price). -->
  <station gapMin="5" gapMax="10" sections="2" itemsPerSection="3" sellPercent="50" cargoSlots="4"
      maxWeaponSystems="4" crewSkillChance="30" systemRepair="0.48"/>

  <!-- Battlesuits (heromedel 2026-10-29): strayHit is the % chance per bolt that a suit drifting beside the firing
       weapon (or beside the target of its own side's missed bolt) is hit; guardianHit the % chance a guardian suit
       hits an enemy suit each turn. A hit wounds the pilot. Ai-Generated-Proposal numbers. -->
  <suits strayHit="15" guardianHit="50"/>

  <!-- Crew XP (GDD 7H, Decided): XP to reach Veteran, then more to reach Master, and XP per event. -->
  <xp veteran="100" master="150" dodge="6.7" shieldPopped="1.8" volley="1.5" repairPoint="5.6" combat="12.5"/>
</rules>
