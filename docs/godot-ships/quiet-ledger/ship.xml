<?xml version="1.0" encoding="UTF-8"?>
<!-- Senti-GPH "Quiet Ledger", bands 5-6, doomed Senti clusters (Senti Pickets squad). Ai-Generated-Proposal (2026-11-14),
     Infall: Ship Designs: the larger Senti hull for the crew killers (docs/ship-suggestions.md). Senti core by bars, a
     Shield Projector, the AAA at the heart of the array room, a Backup Battery, Hacking (Intrusion Array) and a Crew
     Teleporter. No Life Support or Medbay: Senti don't breathe, and the AAA brings the dead back. The docs' system
     battery for the AAA isn't in the game yet. -->
<ship id="quiet-ledger" name="Senti Quiet Ledger" class="Quiet Ledger" race="senti" faction="senti" style="senti" center="Tile" hull="18">
	<reactor type="pool" level="16"/>
	<description>It burns some rooms and opens others to space, then broadcasts its holograms into the rooms nobody else can live in.</description>
	<room id="0" from="-1,-3" to="1,-3" name="Bridge"/>
	<room id="1" from="-1,-2" to="1,-1" name="Fore hall"/>
	<room id="2" from="-2,-1" to="-2,0" name="Port bay"/>
	<room id="3" from="2,-1" to="2,0" name="Starboard bay"/>
	<room id="4" from="-1,0" to="1,1" name="Array room"/>
	<room id="5" from="-1,2" to="1,3" name="Aft hold"/>
	<system id="piloting" tile="-1,-3" level="2" wall="north"/>
	<system id="sensors" tile="1,-3" level="2" wall="north"/>
	<system id="weapons" tile="-1,-2" level="4" wall="west"/>
	<system id="intrusion-array" tile="1,-2" level="2" wall="east"/>
	<system id="backup-battery" tile="-2,0" level="1" wall="west"/>
	<system id="crew-teleporter" tile="2,0" level="2" wall="east"/>
	<system id="shield-projector" tile="-1,0" level="3" wall="west"/>
	<system id="aaa" tile="0,1" level="3" wall="none"/>
	<system id="engines" tile="-1,3" level="2" wall="south"/>
	<door id="0" tile="0,-3" facing="south"/>
	<door id="1" tile="-1,-1" facing="west"/>
	<door id="2" tile="1,-1" facing="east"/>
	<door id="3" tile="0,-1" facing="south"/>
	<door id="4" tile="1,1" facing="south"/>
	<door id="5" tile="-2,-1" facing="west" note="airlock"/>
	<door id="6" tile="2,-1" facing="east" note="airlock"/>
	<mount id="1" tile="-1,-4" slide="up"/>
	<mount id="2" tile="1,-4" slide="up"/>
	<mount id="3" tile="-3,-1" slide="left"/>
	<mount id="4" tile="3,-1" slide="right"/>
	<mount id="5" tile="-3,1" slide="left"/>
	<mount id="6" tile="3,1" slide="right"/>
	<weapons>
		<weapon id="3b-01-f1" mount="1"/>
		<weapon id="2l-01-b1" mount="2"/>
	</weapons>
	<crew>
		<member race="senti" station="piloting"/>
		<member race="senti" station="weapons"/>
		<member race="senti" station="teleporter"/>
	</crew>
	<!-- Crew-kill: breach the Life Support so the air drains, burn the Med Bay, hack Doors so they can't vent, then the
	     holograms take the rooms nobody else can live in. The laser that gets through takes the shields first. -->
	<ai plan="crew-kill">
		<target unless="ownCrewIn" system="shields" weapon="2L 01 B1" when="onlyThisGetsThrough" weight="0.9"/>
		<target unless="ownCrewIn" system="oxygen" weapon="2L 01 B1" weight="0.85"/>
		<target unless="ownCrewIn" system="medbay" weapon="3B 01 F1" weight="0.85"/>
		<target unless="ownCrewIn" system="aaa" weapon="3B 01 F1" weight="0.85"/>
		<hack system="medbay" weight="0.9"/>
		<hack system="aaa" weight="0.9"/>
		<hack system="doors" when="enemyMedBayDown"/>
		<board system="oxygen" when="enemyLifeSupportDown" weight="0.85"/>
		<board system="medbay" when="enemyWounded" weight="0.75"/>
	</ai>
</ship>
