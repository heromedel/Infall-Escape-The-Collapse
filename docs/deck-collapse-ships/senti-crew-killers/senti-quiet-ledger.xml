<!-- Senti-GPH "Quiet Ledger": a doomed-Senti crew killer, bands 5-6. Ai-Generated-Proposal (2026-10-29). Uses only
     Deck Collapse's current rules. -->
<ship bands="5-6" name="Quiet Ledger" race="Senti-GPH" faction="Senti-GPH" color="#D2FF00" hull="14" missiles="0">
  <note>Burns some systems and breaches others, then teleports its holograms into the rooms nobody can live in: fire and lost air don't touch them. Hacks the Med Bay or Airlock Control so the crew can't heal or vent.</note>
  <power kind="AZC" level="3"/>
  <system type="piloting" level="2"/>
  <system type="sensors" level="2"/>
  <system type="shields" level="2"/>
  <system type="engines" level="2"/>
  <system type="hacking" level="2"/>
  <system type="teleport" level="2"/>                                <!-- stands in for an upgraded AAA broadcasting avatars aboard (race profile 9) -->
  <system type="weapon" id="weapons" name="Weapons" level="4">
    <weapon name="3B 01 F1" kind="beam" power="2" shots="1" damage="1" rooms="3" fire="100" tech="digital"/>
    <weapon name="2L 01 B1" kind="laser" power="2" shots="2" damage="1" breach="60" tech="digital"/>          <!-- breaches drain a system's air -->
  </system>
  <crew name="Pilot" race="Senti-GPH" station="piloting"/>
  <crew name="Gunner" race="Senti-GPH" station="weapons"/>
  <crew name="Avatar" race="Senti-GPH" station="teleport"/>
  <crew name="Avatar" race="Senti-GPH" station="teleport"/>
  <!-- Captain plan, Ai-Generated-Proposal (2026-10-30). Lines marked G22-G27 use features Deck Collapse doesn't have yet (README.md). -->
  <ai plan="crew-kill">
    <!-- Breach the Life Support so the air drains, burn the Med Bay, then send the holograms into the rooms nobody
         else can live in. Hack the Airlock Control so the crew can't vent the fires out. -->
    <target unless="ownCrewIn" system="lifeSupport" weapon="2L 01 B1" weight="0.85"/>
    <target unless="ownCrewIn" system="medBay" weapon="3B 01 F1" weight="0.85"/>
    <target unless="ownCrewIn" system="airlock" weapon="2L 01 B1" when="enemyLifeSupportDown" weight="0.6"/>  <!-- G25 -->
    <hack system="medBay" weight="0.9"/>                                                    <!-- G24 -->
    <hack system="airlock" when="enemyMedBayDown"/>
    <board system="lifeSupport" when="enemyLifeSupportDown" weight="0.85"/>                <!-- G23: keep it from being repaired -->
    <board system="medBay" when="enemyWounded" weight="0.75"/>
  </ai>
</ship>
