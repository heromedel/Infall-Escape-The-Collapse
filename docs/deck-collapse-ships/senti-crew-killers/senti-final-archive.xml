<?xml version="1.0" encoding="UTF-8"?>
<!-- Senti-GPH "Final Archive": a doomed-Senti crew killer, bands 7-8. Ai-Generated-Proposal (2026-10-29). Needs two
     new Deck Collapse rules, G20 (crewDamage) and G21 (bomb family); see ../README.md. -->
<ship bands="7-8" name="Final Archive" race="Senti-GPH" faction="Senti-GPH" color="#D2FF00" hull="18" missiles="4">
  <note>Kills the crew and keeps the ship. An anti-bio beam sweeps four systems without scratching them, and bio bombs are broadcast straight into a room. Its holograms finish whoever is left.</note>
  <power kind="AZC" level="4"/>
  <system type="piloting" level="2"/>
  <system type="sensors" level="3"/>
  <system type="shields" level="3"/>
  <system type="engines" level="2"/>
  <system type="hacking" level="2"/>
  <system type="aaa" level="2"/>                                       <!-- hosts 3 Senti per level; brings the dead back -->
  <system type="teleport" level="2"/>
  <system type="weapon" id="weapons" name="Weapons" level="6">
    <weapon name="4B 00 X1" kind="beam" power="3" shots="1" damage="0" rooms="4" crewDamage="3" tech="digital"/>   <!-- G20: the genre's anti-bio beam -->
    <weapon name="BB 00 X1" kind="bomb" power="2" shots="1" damage="0" crewDamage="4" tech="digital"/>             <!-- G20, G21: a bio bomb; uses a missile -->
    <weapon name="3B 01 F1" kind="beam" power="2" shots="1" damage="1" rooms="3" fire="100" tech="digital"/>
  </system>
  <crew name="Pilot" race="Senti-GPH" station="piloting"/>
  <crew name="Gunner" race="Senti-GPH" station="weapons"/>
  <crew name="Avatar" race="Senti-GPH" station="teleport"/>
  <crew name="Avatar" race="Senti-GPH" station="teleport"/>
  <!-- Captain plan, Ai-Generated-Proposal (2026-10-30). Lines marked G22-G27 use features Deck Collapse doesn't have yet (README.md). -->
  <ai plan="crew-kill">
    <!-- Keep the ship, kill the crew: bio bomb the Med Bay where the hurt gather, burn the Life Support, and let the
         anti-bio beam sweep the most crowded systems (crew-kill's ordinary aiming). -->
    <target unless="ownCrewIn" system="medBay" weapon="BB 00 X1" when="enemyWounded" weight="0.85"/>
    <target unless="ownCrewIn" system="aaa" weapon="BB 00 X1" when="enemyWounded" weight="0.85"/>   <!-- Senti ships: the AAA replaces the Med Bay -->
    <target unless="ownCrewIn" system="lifeSupport" weapon="3B 01 F1" weight="0.75"/>
    <hack system="medBay" weight="0.9"/>                                                    <!-- G24 -->
    <hack system="aaa" weight="0.9"/>   <!-- Senti ships: the AAA replaces the Med Bay -->
    <board system="medBay" when="enemyMedBayDown" weight="0.8"/>                           <!-- G23, G25 -->
    <board system="aaa" when="enemyMedBayDown" weight="0.8"/>   <!-- Senti ships: the AAA replaces the Med Bay -->
    <board system="lifeSupport"/>
  </ai>
</ship>
