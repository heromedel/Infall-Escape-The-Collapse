<?xml version="1.0" encoding="UTF-8"?>
<!-- Malphen "Polyp": a small, weak swarm ship for band 1, met in threes or fours where a Malphen mass grows into
     Abandoned clusters. New design (2026-10-29), Ai-Generated-Proposal, from the Malphen profile (low tech: fleshy
     missiles and flak, the growth organ) and ship-design-process.md (weaker ships for band 1, Malphen swarms).
     The name is what other races call it; Malphen don't speak. Gap references are listed in README.md. -->
<ship name="Polyp" race="Malphen" faction="Malphen" color="#FFA480" hull="5" missiles="4">
  <note>A living ship with one crew it grew. Kill the crew and it grows another unless its growth organ is destroyed first.</note>
  <power kind="pool" level="4"/>                                     <!-- G2: biomechanical pool -->
  <system type="piloting" level="1"/>
  <system type="engines" level="1"/>
  <system type="lifeSupport" level="1"/>
  <system type="growthOrgan" level="1"/>                             <!-- G13 -->
  <system type="weapon" id="weapons" name="Weapons" level="1">        <!-- G3 -->
    <weapon name="Flesh Mortar" kind="missile" power="1" shots="1" damage="1" tech="biomechanical"/>  <!-- G4: a fleshy, Stinger-like missile -->
  </system>
  <crew name="Grown" race="Malphen" station="piloting"/>              <!-- G1: high HP, heals slowly anywhere aboard -->
  <!-- Captain plan, Ai-Generated-Proposal (2026-10-30). Lines marked G22-G27 use features Deck Collapse doesn't have yet (README.md). -->
  <ai plan="destroy">
    <!-- The missile ignores shields: hit the guns. -->
    <target system="weapon" weapon="Flesh Mortar" weight="0.8"/>
    <target system="engines" weapon="Flesh Mortar" when="enemyWeaponsDown"/>
  </ai>
</ship>
