	<room id="4" from="1,-2" to="2,-1" name="Starboard forward"/>
	<room id="5" from="-2,0" to="-2,1" name="Port airlock"/>
	<room id="6" from="-1,0" to="1,2" name="Core room"/>
	<room id="7" from="2,0" to="2,1" name="Starboard airlock"/>
	<room id="8" from="-1,3" to="1,4" name="Aft hall"/>
	<room id="9" from="-1,5" to="1,6" name="Engine room"/>

