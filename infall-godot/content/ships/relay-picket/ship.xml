<?xml version="1.0" encoding="UTF-8"?>
<!-- docs/ship-suggestions.md, Senti-GPH "Relay Picket" (as updated 2026-11-13): a Senti core of 7 bars, a Shield
     Projector, the Armoured Avatar Array in the middle of the big room, a Backup Battery, two beams, two Senti. No Life Support or
     Medbay: Senti don't breathe, and the array mends them. -->
<ship id="relay-picket" name="Senti Relay Picket" class="Relay Picket" race="senti" faction="senti" style="senti" center="Tile" hull="10">
	<reactor type="pool" level="7"/>
	<description>A station picket built round its Armoured Avatar Array. It reads everything about you before it decides anything. Its crew don't breathe, so it carries no Life Support.</description>
	<room id="0" from="-1,-2" to="1,-2" name="Bridge"/>
	<room id="1" from="-1,-1" to="1,1" name="Array room"/>
	<room id="2" from="-2,0" to="-2,0" name="Port airlock"/>
	<room id="3" from="2,0" to="2,0" name="Starboard airlock"/>
	<room id="4" from="-1,2" to="1,2" name="Engine room"/>
	<system id="piloting" tile="-1,-2" level="1" wall="north"/>
	<system id="sensors" tile="1,-2" level="2" wall="north"/>
	<system id="weapons" tile="-1,-1" level="3" wall="west"/>
	<system id="aaa" tile="0,0" level="2" wall="none"/>
	<system id="shield-projector" tile="1,1" level="1" wall="east"/>
	<system id="engines" tile="-1,2" level="1" wall="south"/>
	<system id="backup-battery" tile="1,-1" level="1" wall="east"/>
	<door id="0" tile="0,-2" facing="south"/>
	<door id="1" tile="-1,0" facing="west"/>
	<door id="2" tile="1,0" facing="east"/>
	<door id="3" tile="0,1" facing="south"/>
	<door id="4" tile="-2,0" facing="west"/>
	<door id="5" tile="2,0" facing="east"/>
	<mount id="1" tile="-1,-3" slide="up"/>
	<mount id="2" tile="1,-3" slide="up"/>
	<mount id="3" tile="-3,0" slide="left"/>
	<mount id="4" tile="3,0" slide="right"/>
	<weapons>
		<weapon id="2b-01-v1" mount="1"/>
		<weapon id="1b-02-v1" mount="2"/>
	</weapons>
	<crew>
		<member race="senti" station="piloting"/>
		<member race="senti" station="weapons"/>
	</crew>
	<!-- The Senti's answer to shields (heromedel, 2026-11-14): the stronger beam cuts the shield room first; the weaker
	     one sweeps it too, so it lands as the layer drops. With the shields down, both go for the weapons. -->
	<ai plan="destroy">
		<target system="shields" weapon="1B 02 V1" unless="enemyShieldsDown" weight="0.9"/>
		<target system="shields" weapon="2B 01 V1" unless="enemyShieldsDown" weight="0.8"/>
		<target system="weapons" weapon="1B 02 V1" when="enemyShieldsDown" weight="0.8"/>
		<target system="weapons" weapon="2B 01 V1" when="enemyShieldsDown" weight="0.7"/>
	</ai>
</ship>
