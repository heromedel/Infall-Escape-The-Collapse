<?xml version="1.0" encoding="UTF-8"?>
<!-- Terran Pirate Hijacker: a mid-tier doomed-Terran pirate (ship-suggestions.md, layout Proposed 2026-10-26).
     4 tiles wide (Point centering on x, so there is no x = 0) and 13 long (Tile centering on y). -->
<ship name="Terran Pirate Hijacker" race="Terran" powerColour="Pirate">
  <center x="Point" y="Tile"/>
  <hull points="14"/>
  <power kind="AZC" level="3"/>
  <art hull="pirate-hijacker-hull.svg" offset="170,125"/>
  <mounts count="6"/>

  <rooms>
    <room id="0"  from="-1,-6" to="1,-5"  note="bridge"/>
    <room id="1"  from="-1,-4" to="1,-4"  note="doors room"/>
    <room id="2"  from="-2,-3" to="-1,-2" note="shields room"/>
    <room id="3"  from="1,-3"  to="2,-2"  note="weapons room"/>
    <room id="4"  from="-2,-1" to="-2,0"  note="port flank"/>
    <room id="5"  from="-1,-1" to="1,0"   note="core room"/>
    <room id="6"  from="2,-1"  to="2,0"   note="starboard flank"/>
    <room id="7"  from="-2,1"  to="-1,2"  note="medbay"/>
    <room id="8"  from="1,1"   to="2,2"   note="teleporter room"/>
    <room id="9"  from="-2,3"  to="2,4"   note="aft hall"/>
    <room id="10" from="-2,5"  to="2,6"   note="engine room"/>
  </rooms>

  <systems>
    <system name="Piloting"        tile="-1,-6" level="2" wall="North"/>
    <system name="Sensors"         tile="1,-6"  level="1" wall="North"/>
    <system name="Doors"           tile="-1,-4" level="2" wall="West"/>
    <system name="Shields"         tile="-2,-3" level="2" wall="West"/>
    <system name="Weapons"         tile="2,-3"  level="3" wall="East"/>
    <system name="AZC"             tile="1,-1"  level="3"/>
    <system name="Medbay"          tile="-2,2"  level="2" wall="West"/>
    <system name="Crew Teleporter" tile="2,2"   level="2" wall="East"/>
    <system name="Engines"         tile="-1,6"  level="3" wall="South"/>
    <system name="Life Support"    tile="1,6"   level="1" wall="South"/>
  </systems>

  <doors>
    <door id="0"  tile="1,-5"  facing="South"/>
    <door id="1"  tile="1,-4"  facing="South"/>
    <door id="2"  tile="-1,-2" facing="East"/>
    <door id="3"  tile="-2,-2" facing="South"/>
    <door id="4"  tile="2,-2"  facing="South"/>
    <door id="5"  tile="-1,-1" facing="West"/>
    <door id="6"  tile="1,0"   facing="East"/>
    <door id="7"  tile="-1,-2" facing="South"/>
    <door id="8"  tile="-1,0"  facing="South"/>
    <door id="9"  tile="1,0"   facing="South"/>
    <door id="10" tile="-1,2"  facing="East"/>
    <door id="11" tile="-1,2"  facing="South"/>
    <door id="12" tile="1,2"   facing="South"/>
    <door id="13" tile="-1,4"  facing="South"/>
    <door id="14" tile="1,4"   facing="South"/>
    <door id="15" tile="-2,3"  facing="West" note="airlock"/>
    <door id="16" tile="-2,4"  facing="West" note="airlock"/>
    <door id="17" tile="2,3"   facing="East" note="airlock"/>
    <door id="18" tile="2,4"   facing="East" note="airlock"/>
  </doors>

  <!-- A ring, one spur East to the Sporewing; the Twinshot is fed twice (the W exits). -->
  <conduits>
    (-1,-6,S,E) (1,-6,S,W) (-1,-5,N,S) (1,-5,N,S) (-1,-4,N,S) (1,-4,N,S)
    (-2,-3,S,E,W) (-1,-3,N,W) (1,-3,N,S) (-2,-2) (-1,-2,E,W) (1,-2)
    (2,-2,E,W) (-2,-1,N,S) (1,-1,N,S) (-2,0,N,S) (1,0,N,E) (2,0,S,W)
    (-2,1,N,S) (2,1,N,S) (-2,2,N,S) (2,2,N,S) (-2,3,N,S) (2,3,N,S)
    (-2,4,N,S) (2,4,N,S) (-2,5,N,E) (-1,5,S,W) (1,5,S,E) (2,5,N,W)
    (-1,6,N,E) (1,6,N,W)
  </conduits>

  <weapons>
    <weapon name="Gat 2.1" mount="3"/>
    <weapon name="Sporewing" mount="4"/>
  </weapons>
  <crew>
    <member race="Terran" count="5"/>
  </crew>
</ship>
